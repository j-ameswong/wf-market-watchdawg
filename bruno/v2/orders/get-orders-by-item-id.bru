meta {
  name: Get Orders By Item Id
  type: http
  seq: 3
}

get {
  url: {{baseV2}}/orders/itemId/{{itemId}}
  body: none
  auth: none
}

headers {
  Platform: {{platform}}
  Crossplay: {{crossplay}}
  Language: {{language}}
}

assert {
  res.status: eq 200
}

docs {
  Alias of Get Orders By Item, keyed on the item `id` instead of `slug`.
}
